# Copy this file to .env. Never commit .env or real keys.
JARVIS_NAME=JARVIS
JARVIS_OWNER_NAME=Boss
JARVIS_LOG_LEVEL=INFO
JARVIS_DATABASE_URL=sqlite:///data/jarvis.db

# Cloud AI provider (optional until configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Voice settings. Voice dependencies are optional extras.
JARVIS_TTS_ENABLED=true
JARVIS_STT_LANGUAGE=en-US
JARVIS_WAKE_WORD_ENABLED=false

# Vision is opt-in. Camera use should be visibly indicated.
JARVIS_CAMERA_ENABLED=false
JARVIS_FACE_MATCH_THRESHOLD=70.0
JARVIS_FACE_ENROLLMENT_SAMPLES=8

# Computer tools are disabled by default. Application launches require a local owner PIN.
JARVIS_ALLOW_APP_LAUNCH=false
JARVIS_ALLOW_FILESYSTEM_WRITES=false
JARVIS_ALLOW_TERMINAL=false
